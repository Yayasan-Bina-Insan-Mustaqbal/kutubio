APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Camera access requires HTTPS, except on localhost. Set the production public URL with https:// when using a tunnel or reverse proxy.
# Password used by DatabaseSeeder to create the initial admin@kutubio.test user
DEFAULT_ADMIN_PASSWORD=password123

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (Sail/PgSQL) ---
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# --- Sail Ports ---
APP_PORT=80
VITE_PORT=5174

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (log by default) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VITE_HMR_HOST=
VITE_HMR_PORT=5174
VITE_HMR_PROTOCOL=wss

# --- Gotenberg (PDF rendering) ---
GOTENBERG_ENDPOINT=http://gotenberg:3000

# --- Ollama (AI: OCR, classification, summarization) ---
# OLLAMA_URL=http://100.121.116.17:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=glm-ocr
OLLAMA_LLM_MODEL=llama3.1:latest

# --- SurrealDB (School data graph: students, teachers, staff) ---
SURREALDB_ENDPOINT=http://127.0.0.1:8000
SURREALDB_NAMESPACE=insan_taqwa
SURREALDB_GRAPH_DATABASE=school_graph_v1
SURREALDB_APP_USER=school_app
SURREALDB_APP_PASS=
SURREALDB_APP_ROLE=app
SURREALDB_TIMEOUT=15
